# Google OAuth Client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Production canonical URL (sitemap, OG, schema) — e.g. https://rasoira.com
VITE_SITE_URL=https://rasoira.com

# Optional: API base URL (default /api — use when API is on another origin)
# VITE_API_BASE=https://api.example.com/api

# Optional: Sentry DSN for client error monitoring
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: CDN base for recipe photos (e.g. https://cdn.rasoira.com/recipes)
# VITE_IMAGE_CDN_BASE=https://cdn.rasoira.com/recipes
