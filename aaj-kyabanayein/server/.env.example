# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Auth — REQUIRED in production (generate a long random string)
JWT_SECRET=change-me-in-production

# CORS — comma-separated allowed origins in production (optional in dev)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Google OAuth — same Client ID as client (Web application type)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Groq API key (FAST — primary for recipe load on select)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Gemini API key (fallback if Groq fails)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# Recommended: Google Custom Search — real photos for EVERY recipe instead
# of AI/studio art. Requires TWO things (both free to create, paid usage
# above 100 queries/day — https://developers.google.com/custom-search/v1/overview):
#   1. GOOGLE_CSE_API_KEY — a Google Cloud Console API key with the
#      "Custom Search API" enabled (console.cloud.google.com/apis/library).
#      This is DIFFERENT from the Gemini/AI Studio key above.
#   2. GOOGLE_CSE_ID — create a search engine (set to "search the entire
#      web" + turn on "Image search") at:
#      https://programmablesearchengine.google.com/
# Once both are set, real recipe photos load from Google first, before
# falling back to Wikimedia/Wikipedia/Openverse, and only fall back to
# AI-generated studio art if none of those return a real photo.
GOOGLE_CSE_API_KEY=your-google-cloud-console-api-key
GOOGLE_CSE_ID=your-search-engine-id

# Optional: Sentry DSN for server error monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Admin panel login (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Nirav@123

# Legacy API key (optional fallback)
# ADMIN_SECRET=rasoira-admin-dev-key
# IMAGE_CDN_BASE=https://cdn.rasoira.com/recipes
