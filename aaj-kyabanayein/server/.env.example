# Google OAuth — same Client ID as client (Web application type)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Groq API key (FAST — primary for recipe load on select)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Gemini API key (fallback if Groq fails)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional: Google Custom Search — for direct Google Image results
# Create CSE at: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your-search-engine-id
