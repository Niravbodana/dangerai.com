# Google OAuth — same Client ID as client (Web application type)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Custom Search — for auto recipe photos & ingredients from Google
# 1. Create API key: https://console.cloud.google.com/apis/credentials
# 2. Enable "Custom Search API"
# 3. Create search engine: https://programmablesearchengine.google.com/
#    - Search the entire web
#    - Enable Image search
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-search-engine-id
