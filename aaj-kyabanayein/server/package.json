{
  "name": "aaj-kyabanayein-server",
  "version": "1.0.0",
  "description": "Rasoira - Meal Planner API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=./src src/index.js",
    "dev:stable": "node src/index.js",
    "dev:watch": "node --watch-path=./src src/index.js",
    "generate-recipes": "node src/scripts/generateRecipes.js",
    "build-recipe-books": "node src/scripts/buildRecipeBooks.js",
    "prefetch-images": "node src/scripts/prefetchRecipeImages.js",
    "db:init": "node src/scripts/initDatabase.js",
    "sync-images": "node src/scripts/syncLocalImages.js",
    "pipeline:run": "node ../scripts/run-recipe-pipeline.mjs run",
    "pipeline:status": "node ../scripts/run-recipe-pipeline.mjs status",
    "pipeline:verify": "node ../scripts/run-recipe-pipeline.mjs verify",
    "pipeline:init-db": "node ../scripts/run-recipe-pipeline.mjs init-db",
    "research:run": "node ../scripts/run-research.mjs run",
    "research:status": "node ../scripts/run-research.mjs status",
    "enterprise:run": "node ../scripts/run-enterprise-research.mjs run",
    "enterprise:status": "node ../scripts/run-enterprise-research.mjs status",
    "phase3:plan": "node ../scripts/run-phase3-import.mjs plan",
    "phase3:import": "node ../scripts/run-phase3-import.mjs import",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/node": "^9.47.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
