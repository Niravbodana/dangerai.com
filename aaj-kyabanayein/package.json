{
  "name": "aaj-kyabanayein",
  "version": "1.0.0",
  "private": true,
  "description": "Rasoira - Indian meal planner (Node + React)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client -- --host",
    "start:server": "npm start --prefix server",
    "build:client": "npm run build --prefix client",
    "test": "npm run test --prefix client",
    "verify": "node scripts/verify-project.mjs",
    "db:init": "npm run db:init --prefix server",
    "dev:kill": "node scripts/kill-dev-ports.mjs",
    "health": "node scripts/check-local-health.mjs",
    "test:server": "npm run test --prefix server",
    "test:all": "npm run test --prefix client && npm run test --prefix server"
  }
}
