{
  "name": "aaj-kyabanayein",
  "version": "1.0.0",
  "private": true,
  "description": "Rasoira - Indian meal planner (Node + React)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client -- --host",
    "start:server": "npm start --prefix server",
    "build:client": "npm run build --prefix client",
    "test": "npm run test --prefix client",
    "generate-recipes": "npm run generate-recipes --prefix server",
    "build-recipe-books": "npm run build-recipe-books --prefix server",
    "prefetch-images": "npm run prefetch-images --prefix server",
    "verify": "node scripts/verify-project.mjs",
    "audit-recipes": "node scripts/audit-recipe-quality.mjs",
    "audit-customers": "node scripts/customer-audit-10k.mjs",
    "merge-recipes": "node server/src/scripts/mergeNewRecipes.js",
    "db:init": "npm run db:init --prefix server",
    "sync-images": "npm run sync-images --prefix server",
    "dev:kill": "node scripts/kill-dev-ports.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs"
  }
}
